// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection string (?pgbouncer=true or pooler endpoint)
  directUrl = env("DIRECT_URL")   // Direct connection string for Prisma CLI migrations
}

enum ExpenseCategory {
  SOCIAL_MEDIA   @map("Social Media")
  RENT           @map("Rent")
  DELIVERY       @map("Delivery")
  SALARY         @map("Salary")
  PRODUCT_COST   @map("Product Cost")
}

enum IncomeChannel {
  INSTAGRAM @map("Instagram")
  TIKTOK    @map("TikTok")
  TELEGRAM  @map("Telegram")
  FACEBOOK  @map("Facebook")
  OTHER     @map("Other")
}

model Expense {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([category])
}

model Income {
  id          String        @id @default(uuid())
  amount      Decimal       @db.Decimal(12, 2)
  channel     IncomeChannel
  description String?
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([date])
  @@index([channel])
}
